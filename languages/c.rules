block@scope -> 
    statement@stat block@scope?;
    
statement ->    
    interface@interf | 
    enum@enum | 
    def@def | 
    struct@struct | 
    include@inc | 
    dowhile@dowhile SEMICOLON | 
    whileloop@while | 
    conditional@cond | 
    switch@switch | 
    funcdec@func | 
    funcfwd SEMICOLON |
    LBRACE block@scope? RBRACE | 
    forloop@for | 
    jump@jmp SEMICOLON | 
    contflow@ret SEMICOLON | 
    chain@exp SEMICOLON | 
    assignment@assign SEMICOLON | 
    declaration@dec SEMICOLON | 
    label@label | 
    funccall@call SEMICOLON;
    
def@def -> 
    "defer" statement@exp;
    
include@inc -> 
    SYMBOL("@") "includeC" LPAREN CONST@inc RPAREN | 
    SYMBOL("#") "include" CONST@inc;
    
separator -> 
    SEMICOLON | NEWLINE;
    
assignment@assign -> 
    variable@var OPERATOR("=") expression@exp | chain@var OPERATOR("=") expression@exp;
    
funccall@call -> 
    OPERATOR@deref("*")? IDENTIFIER@func LPAREN argument@args? RPAREN;

funcfwd -> "extern" funcsign |
        "extern" IDENTIFIER OPERATOR("*")? IDENTIFIER;
    
funcdec@func -> 
    IDENTIFIER@type? IDENTIFIER@name funcarguments@param LBRACE block@scope? RBRACE;

funcsign@func -> 
    IDENTIFIER@type? IDENTIFIER@name funcarguments@param;

funcarguments ->
    LPAREN argdec@param? RPAREN;

argdec@param -> 
    "const"? IDENTIFIER@type OPERATOR@ref("*")? IDENTIFIER@name COMMA argdec@param | IDENTIFIER@type OPERATOR@ref("*")? IDENTIFIER@name;

argument@args -> 
    argname? expression@exp COMMA argument@args | argname? expression@exp;

argname -> 
    IDENTIFIER COLON;

conditional@cond -> 
    "if" condition@cond LBRACE block@scope? RBRACE else@else? |
    "if" condition@cond statement@scope? else@else?;
    
else@else -> 
    "else" LBRACE block@scope? RBRACE | "else" conditional@cond;
    
condition -> 
    LPAREN expression@cond RPAREN |
    LPAREN expression@cond RPAREN;
    
declaration@dec -> 
    IDENTIFIER@type OPERATOR@ref("*")? IDENTIFIER@name OPERATOR("=") expression@exp | 
    IDENTIFIER@type OPERATOR@ref("*")? IDENTIFIER@name;
    
jump@jmp -> 
    "goto" IDENTIFIER@jmp;
    
label@label -> 
    IDENTIFIER@name COLON;
    
expression@exp -> 
    OPERATOR@op("!") expression@exp | 
    LPAREN@syn expression@exp RPAREN | 
    math@exp | 
    lambda@func | 
    chain@exp | 
    funccall@exp | 
    CONST@val | 
    LBRACE@val RBRACE |
    variable@var;
    
lambda@func -> 
    IDENTIFIER@type? LPAREN argdec@param RPAREN LBRACE block@scope? RBRACE;
    
chain@var -> 
    variable@var DOT@op funccall@exp | 
    variable@var DOT@op variable@exp | 
    funccall@exp DOT@op variable@exp;
    # variable@var OPERATOR@op("->") funccall@exp | 
    # variable@var OPERATOR@op("->") variable@exp | ;
    
math@exp -> 
    funccall@var OPERATOR@op expression@exp | 
    chain@var OPERATOR@op expression@exp |
    CONST@val OPERATOR@op expression@exp | 
    variable@var OPERATOR@op expression@exp;
    
variable@var -> 
    OPERATOR@deref("*")? OPERATOR@addr("&")? IDENTIFIER@var LBRACKET@op expression@exp RBRACKET | 
    OPERATOR@deref("*")? OPERATOR@addr("&")? IDENTIFIER@var |
    IDENTIFIER@var;
    
forloop@for -> 
    "for" LPAREN declaration@dec SEMICOLON condition@cond SEMICOLON assignment@assign RPAREN LBRACE block@scope? RBRACE;
    
whileloop@while -> 
    "while" condition@cond LBRACE block@scope? RBRACE;
    
dowhile@dowhile -> 
    "do" LBRACE block@scope? RBRACE "while" condition@cond;
    
enum@enum -> 
    "enum" IDENTIFIER@name LBRACE enumcase@enum_case? RBRACE;
    
enumcase@enum_case -> 
    IDENTIFIER@name COMMA enumcase@enum_case? | IDENTIFIER@name;
    
struct@struct -> 
    "struct" IDENTIFIER@name LBRACE decblock@scope? RBRACE | 
    "struct" IDENTIFIER@name COLON IDENTIFIER@parent? LBRACE decblock@scope? RBRACE;
    
decblock@scope -> 
    declaration@dec SEMICOLON decblock@scope? | funcdec@func decblock@scope?;
    
contflow@ret -> 
    "return" expression@exp? |
    "continue" |
    "break";
    
interface@interf -> 
    "interface" IDENTIFIER@name LBRACE intblock@scope? RBRACE;
    
intblock@scope -> 
    declaration@dec SEMICOLON intblock@scope? | funcsign@func SEMICOLON intblock@scope?;
    
switch@switch -> 
    "switch" LPAREN expression@exp RPAREN LBRACE switchbody@scope? RBRACE | "switch" expression@exp LBRACE switchbody@scope? RBRACE;
    
switchbody@cases -> 
    "case"? expression@exp COLON LBRACE block@scope? RBRACE switchbody@cases?;
